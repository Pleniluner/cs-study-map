# Environment variables only; this file is not loaded automatically.
# GITHUB_TOKEN is optional locally for public repositories (higher rate limits).
# AI endpoint examples: https://api.example.com/v1 (chat) or a Responses endpoint.
CS_STUDY_API_BASE=
CS_STUDY_API_KEY=
CS_STUDY_MODEL=
CS_STUDY_API_STYLE=chat
CS_STUDY_TIMEOUT=180
CS_STUDY_PROVIDER=api
# Local alternative: CS_STUDY_PROVIDER=codex, CS_STUDY_MODEL=<available model>
# CS_STUDY_CODEX_BIN=<path to a current Codex CLI executable>
